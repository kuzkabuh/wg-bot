# === TELEGRAM ===
BOT_TOKEN=put_your_bot_token_here

# Список админов через запятую (числовые telegram-id)
ADMIN_IDS=123456789,987654321

# === WG / SERVER ===
# Имя интерфейса WireGuard
WG_INTERFACE=wg0

# Путь к основному конфигу wg (для подстраховки при парсинге)
WG_CONFIG=/etc/wireguard/wg0.conf

# Публичный адрес сервера (IP или домен)
SERVER_PUBLIC_ENDPOINT=77.238.224.37

# Порт wg (как в wg0.conf)
SERVER_PUBLIC_PORT=51820

# Если публичный ключ нельзя прочитать автоматически — укажите здесь (опционально)
SERVER_PUBLIC_KEY=

# Внутренние подсети
WG_PRIVATE_SUBNET_V4=10.8.0.0/24
WG_PRIVATE_SUBNET_V6=fd86:ea04:1115::/64

# DNS для клиентов (можно указать несколько через запятую)
WG_DNS=1.1.1.1,1.0.0.1

# Какие сети маршрутизировать через VPN у клиента
WG_ALLOWED_IPS=0.0.0.0/0,::/0

# Директории данных
DATA_DIR=./data
CONFIGS_DIR=./data/configs
QRCODES_DIR=./data/qrcodes

# === БИЛЛИНГ/ТАРИФЫ ===
TRIAL_DAYS=7
MONTH_DAYS=30

# Лимит устройств по умолчанию (1 для триала)
DEFAULT_DEVICES_LIMIT=1

# === ПОВЕДЕНИЕ БОТА ===
# Удалять ли сервисные сообщения (рекомендуется false; пользователь просил не удалять):
DELETE_MESSAGES=false

# Часовой пояс для человека-понятных дат (напр. Europe/Moscow или Europe/Amsterdam)
TZ=Europe/Moscow